{
  "expo": {
    "name": "Artiz",
    "slug": "artiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/artiz/logo-2026.png",
    "scheme": "artiz",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "fr.artiz.mobile",
      "icon": "./assets/artiz/logo-2026.png"
    },
    "android": {
      "package": "fr.artiz.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/artiz/logo-2026.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/artiz/logo-2026.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/artiz/logo-2026.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b5fe0081-faaa-437c-bbae-389a81cd3c29"
      }
    },
    "owner": "vorn"
  }
}
